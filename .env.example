# Kopieren nach .env.local (lokal) bzw. in Vercel unter Settings → Environment Variables eintragen.

# --- n8n: Formulare ---------------------------------------------------------
# Ohne diese Werte laufen die Formulare im Demo-Modus (es wird nichts gespeichert).
N8N_WEBHOOK_WARTELISTE=
N8N_WEBHOOK_KONTAKT=

# --- n8n: Mitgliederbereich --------------------------------------------------
# Ohne diese Werte werden Bildanalyse, Fahrzeugdaten und Benachrichtigungen simuliert.
# Bildanalyse und Fahrzeugdaten (antworten mit JSON, siehe README)
N8N_WEBHOOK_FAHRZEUGSCHEIN=
N8N_WEBHOOK_FAHRZEUGDATEN=
N8N_WEBHOOK_BELEG=
# Ereignisse: ein Sammel-Webhook für alles …
N8N_WEBHOOK_EREIGNISSE=
# … und optional eigene Webhooks je Themengruppe (haben Vorrang vor dem Sammel-Webhook)
N8N_WEBHOOK_EVENTS=
N8N_WEBHOOK_SUPPORT=
N8N_WEBHOOK_WERKZEUG=
N8N_WEBHOOK_ABO=
N8N_WEBHOOK_WORKSHOPS=
N8N_WEBHOOK_BUCHUNGEN=

# --- Shopify (headless), noch nicht angebunden ------------------------------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# --- Buchungs-Backend, noch nicht angebunden --------------------------------
BUCHUNG_API_URL=
